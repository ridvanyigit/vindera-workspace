      "expected": {"total_cost": 76.90, "platform_fees": 6.35, "payment_fees": 3.48, "return_reserve": 3.60, "net_profit": 22.77, "net_margin_pct": 29.61, "break_even_price": 94.45, "emergency_price": 102.00, "passes_guardrails": true}
