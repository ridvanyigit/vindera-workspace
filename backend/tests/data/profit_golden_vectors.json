      "expected": {"total_cost": 10.00, "platform_fees": 60.00, "payment_fees": 30.00, "return_reserve": 10.00, "net_profit": -10.00, "net_margin_pct": -100.00, "break_even_price": null, "emergency_price": 85.00, "passes_guardrails": false}
    }
