      "expected": {"total_cost": 60.00, "platform_fees": 0.00, "payment_fees": 0.00, "return_reserve": 0.00, "net_profit": 15.00, "net_margin_pct": 25.00, "break_even_price": 60.00, "emergency_price": 63.75, "passes_guardrails": true}
    },
    {
      "name": "guardrail boundary: one cent below fails",
      "input": {"sell_price": 74.99, "purchase_price": 60.00, "inbound_shipping": 0, "packaging": 0, "outbound_shipping": 0},
      "settings": {"platform_fee_pct": 0, "platform_fee_fixed_eur": 0, "payment_fee_pct": 0, "return_reserve_pct": 0, "min_net_margin_pct": 25, "min_net_profit_eur": 15},
      "expected": {"total_cost": 60.00, "platform_fees": 0.00, "payment_fees": 0.00, "return_reserve": 0.00, "net_profit": 14.99, "net_margin_pct": 24.98, "break_even_price": 60.00, "emergency_price": 63.74, "passes_guardrails": false}
