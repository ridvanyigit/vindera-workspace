      "expected": {"total_cost": 50.00, "platform_fees": 0.00, "payment_fees": 0.00, "return_reserve": 0.00, "net_profit": 50.00, "net_margin_pct": 100.00, "break_even_price": 50.00, "emergency_price": 85.00, "passes_guardrails": true}
