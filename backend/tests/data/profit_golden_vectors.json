      "input": {"sell_price": 60.00, "purchase_price": 40.00, "inbound_shipping": 0, "packaging": 1.50, "outbound_shipping": 6.90},
      "settings": {"platform_fee_pct": 0, "platform_fee_fixed_eur": 0, "payment_fee_pct": 0, "return_reserve_pct": 3, "min_net_margin_pct": 25, "min_net_profit_eur": 15},
      "expected": {"total_cost": 41.50, "platform_fees": 0.00, "payment_fees": 0.00, "return_reserve": 1.80, "net_profit": 9.80, "net_margin_pct": 23.61, "break_even_price": 49.90, "emergency_price": 51.00, "passes_guardrails": false}
