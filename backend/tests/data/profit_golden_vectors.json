      "input": {"sell_price": 8.01, "purchase_price": 8.00, "inbound_shipping": 0, "packaging": 0, "outbound_shipping": 0},
      "settings": {"platform_fee_pct": 0, "platform_fee_fixed_eur": 0, "payment_fee_pct": 0, "return_reserve_pct": 0, "min_net_margin_pct": 25, "min_net_profit_eur": 15},
      "expected": {"total_cost": 8.00, "platform_fees": 0.00, "payment_fees": 0.00, "return_reserve": 0.00, "net_profit": 0.01, "net_margin_pct": 0.13, "break_even_price": 8.00, "emergency_price": 8.00, "passes_guardrails": false}
    },
    {
      "name": "rounding: negative margin tie -0.125% rounds away from zero to -0.13",
      "input": {"sell_price": 7.99, "purchase_price": 8.00, "inbound_shipping": 0, "packaging": 0, "outbound_shipping": 0},
      "settings": {"platform_fee_pct": 0, "platform_fee_fixed_eur": 0, "payment_fee_pct": 0, "return_reserve_pct": 0, "min_net_margin_pct": 25, "min_net_profit_eur": 15},
