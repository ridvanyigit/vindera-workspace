# Production settings for infrastructure/prod/docker-compose.yml.
#
#   cp .env.prod.example .env.prod      (on the server, in this folder)
#   chmod 600 .env.prod
#
# .env.prod is git-ignored and holds real secrets: never commit it, never paste it into
# a chat. Generate the random values with:  openssl rand -hex 32
# A line left empty where a value is REQUIRED makes `docker compose` stop with a message.

# --- Domains (DNS A records must point to this server before the first start) ---
API_DOMAIN=api.example.com
N8N_DOMAIN=n8n.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=owner@example.com

# --- Supabase (Dashboard -> Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key: full access, server only. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend ---
# Origins allowed to call the API: the production frontend (no localhost entries; comma-separated).
CORS_ALLOWED_ORIGINS=https://www.example.com
# n8n sends this as the X-Vindera-Key header. 32+ characters.
AUTOMATION_SHARED_SECRET=
# Prometheus presents this when scraping /metrics. 32+ characters.
METRICS_TOKEN=
# Optional: without a key the matching feature simply does nothing (a scan then fails visibly).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
KEEPA_API_KEY=
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
# Optional error tracking (leave empty to switch it off).
SENTRY_DSN=
LOG_LEVEL=INFO
SELL_PRICE_POSITION=0.5

# --- n8n ---
# Encrypts n8n's stored credentials. Generate once and KEEP A COPY somewhere safe: without it
# the credentials saved in n8n cannot be read again.
N8N_ENCRYPTION_KEY=
# `latest` follows n8n releases. After the first successful start, run `docker compose --env-file .env.prod images`
# and put the shown version here to stop surprise upgrades.
N8N_IMAGE_TAG=latest

# --- Grafana (used through an SSH tunnel) ---
GRAFANA_ADMIN_PASSWORD=
