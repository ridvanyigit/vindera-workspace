# Copy to backup.env (same folder, git-ignored) and chmod 600 it. See backup.sh for details.

# REQUIRED. Supabase Dashboard -> Connect -> "Session pooler" connection string, with your
# database password filled in (Project Settings -> Database -> Reset database password).
SUPABASE_DB_URL=

# Where the dumps go, and how long they are kept.
BACKUP_DIR=/var/backups/vindera
BACKUP_RETENTION_DAYS=30

# Optional: encrypt every backup with age (https://github.com/FiloSottile/age).
# Create a key pair ONCE on your own computer:  age-keygen -o vindera-backup.key
# Put the public key (starts with age1...) here and keep the .key file OFF this server.
BACKUP_AGE_RECIPIENT=

# Optional: healthchecks.io-style URL, called after each successful backup.
BACKUP_PING_URL=
