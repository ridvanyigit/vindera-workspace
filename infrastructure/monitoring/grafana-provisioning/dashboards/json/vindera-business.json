          "rawSql": "SELECT p.title AS \"Ürün\", o.sku AS \"SKU\", o.return_by AS \"İade Tarihi\", (o.return_by - current_date) AS \"Kalan Gün\" FROM opportunities o JOIN products p ON p.id = o.product_id WHERE o.deleted_at IS NULL AND o.status IN ('bought','in_inventory','listed') AND o.return_by IS NOT NULL AND o.return_by <= current_date + 5 ORDER BY o.return_by ASC",
