# Copy to `.env` in this folder (git-ignored) and choose a strong password.
# Read by `docker compose up -d` here; it is the Grafana admin password on the first start.
GRAFANA_ADMIN_PASSWORD=

# Read by grafana-provisioning/datasources/datasources.yml, so Grafana can
# recreate the "vindera-postgres" data source (business dashboard, DB health
# dashboard) from scratch after a lost container or a wiped Grafana volume.
# Local Supabase defaults shown; point these at the hosted project's "Session
# pooler" connection details (Supabase Dashboard -> Connect) once VPS + domain
# are set up.
VINDERA_DB_HOST=host.docker.internal
VINDERA_DB_PORT=54322
VINDERA_DB_USER=postgres
VINDERA_DB_PASSWORD=postgres

# Same Pushover app as the backend (root /.env). Read by
# grafana-provisioning/alerting/contactpoints.yml so the two Pushover contact
# points survive a lost container or a wiped Grafana volume.
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
