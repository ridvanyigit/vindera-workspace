# Public settings for the Next.js frontend. Copy to .env.local for local development;
# on Vercel enter the same names under Project -> Settings -> Environment Variables.
#
# Everything here is PUBLIC: NEXT_PUBLIC_* values are shipped to every visitor's browser.
# Never put the Supabase service_role key or any other secret in this file.
# They are read at BUILD time: after changing one on Vercel, redeploy.

# Supabase project (Dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / publishable key. NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the FastAPI backend lives (no trailing slash). Local: http://localhost:8000.
# Production: https://api.<your-domain>. Also feeds the Content-Security-Policy.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The public address of this site, used for robots.txt, sitemap.xml and canonical links.
# Local: http://localhost:3000. Production: https://www.<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
