# ==========================================
# VINDERA PROJECT - ENVIRONMENT VARIABLES
# ==========================================
# Copy to `.env` at the workspace root. The backend reads it via
# `env_file="../.env"` in `backend/src/core/config.py`.

# 1. SUPABASE (Database)
SUPABASE_URL="here_your_supabase_project_url"
SUPABASE_ANON_KEY="here_your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="here_your_supabase_service_role_key"

# 2. OPENAI (Agentic AI & Listing Generator)
OPENAI_API_KEY="here_your_openai_api_key"
# Model for the deal analysis and the listing copy.
OPENAI_MODEL="gpt-4o-mini"

# 3. KEEPA API (Amazon Cross-Border Price Tracker)
KEEPA_API_KEY="here_your_keepa_api_key"

# 4. PUSHOVER (Notifications)
PUSHOVER_USER_KEY="here_your_pushover_user_key"
PUSHOVER_API_TOKEN="here_your_pushover_api_token"

# 5. GENERAL / BACKEND
# "development" | "test" | "production". In production the backend refuses to
# start unless AUTOMATION_SHARED_SECRET and METRICS_TOKEN are set (32+ chars),
# CORS_ALLOWED_ORIGINS has no localhost entry and ALLOW_MOCK_DATA is false. It
# also turns off /docs, /redoc and /openapi.json.
ENVIRONMENT="development"

# Comma-separated list of origins allowed to call the API.
# Add the production frontend domain here before deploying.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Shared secret n8n sends as the `X-Vindera-Key` header to trigger scans.
# Generate with: openssl rand -hex 32
AUTOMATION_SHARED_SECRET="here_your_automation_shared_secret"

# Bearer token Prometheus uses to scrape /metrics. Generate with: openssl rand -hex 32
# The same value goes into infrastructure/monitoring/secrets/metrics_token.
# Left empty in development, /metrics is open (never in production).
METRICS_TOKEN="here_your_metrics_token"

# Optional error tracking (leave empty to disable). Requests bodies, headers with
# credentials and user data are removed before an event is sent.
SENTRY_DSN=""

# Log verbosity: DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stdout.
LOG_LEVEL="INFO"

# Development aid only: when true, a Keepa/OpenAI failure produces clearly
# marked [MOCK] data instead of a failed scan. Must be false in production.
ALLOW_MOCK_DATA="false"

# Amazon.de return window in days (used to compute the "return by" date).
RETURN_WINDOW_DAYS="30"

# Where the suggested Willhaben price sits between today's Amazon price (0) and
# its 90-day reference price (1). 0.5 = exactly halfway.
SELL_PRICE_POSITION="0.5"

# 6. MONITORING (infrastructure/monitoring/docker-compose.yml)
GRAFANA_ADMIN_PASSWORD="here_your_grafana_admin_password"

# 7. LLMOPS SANDBOX (optional - learn/llmops; see SETUP.md #17)
# Every value below is optional and off/unset by default. None of it is needed
# to run the real application - only for the reproducible LLMOps modules.

# Module 1 (Langfuse tracing): create a free project at cloud.langfuse.com,
# then Settings -> API Keys. Leave both keys empty to disable entirely.
LANGFUSE_PUBLIC_KEY="here_your_langfuse_public_key"
LANGFUSE_SECRET_KEY="here_your_langfuse_secret_key"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Module 4 (LiteLLM gateway): point every OpenAI call at the local proxy
# instead of api.openai.com. Leave empty to use OpenAI directly.
OPENAI_BASE_URL=""

# Module 9 (Ollama "second opinion"): off by default, and never affects a
# saved deal even when enabled - see backend/src/agents/second_opinion.py.
ENABLE_SECOND_OPINION_MODEL="false"
SECOND_OPINION_BASE_URL="http://localhost:11434/v1"
SECOND_OPINION_MODEL="gemma3:1b"

# ==========================================
# FRONTEND (frontend/.env.local)
# ==========================================
# NEXT_PUBLIC_SUPABASE_URL="here_your_supabase_project_url"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="here_your_supabase_anon_key"
# NEXT_PUBLIC_API_URL="http://localhost:8000"
