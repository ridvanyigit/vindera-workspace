# ==========================================
# VINDERA PROJECT - ENVIRONMENT VARIABLES
# ==========================================
# Copy to `.env` at the workspace root. The backend reads it via
# `env_file="../.env"` in backend/src/core/config.py.

# 1. SUPABASE (Database)
SUPABASE_URL="your_supabase_project_url_here"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# 2. OPENAI (Agentic AI & Listing Generator)
OPENAI_API_KEY="your_openai_api_key_here"

# 3. KEEPA API (Amazon Cross-Border Price Tracker)
KEEPA_API_KEY="your_keepa_api_key_here"

# 4. PUSHOVER (Notifications)
PUSHOVER_USER_KEY="your_pushover_user_key_here"
PUSHOVER_API_TOKEN="your_pushover_api_token_here"

# 5. GENERAL / BACKEND
# "development" | "test" | "production". In production the backend refuses to
# start unless AUTOMATION_SHARED_SECRET and METRICS_TOKEN are set (32+ chars),
# CORS_ALLOWED_ORIGINS has no localhost entry and ALLOW_MOCK_DATA is false. It
# also turns off /docs, /redoc and /openapi.json.
ENVIRONMENT="development"

# Comma-separated list of origins allowed to call the API.
# Add the production frontend domain here before deploying.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Shared secret n8n sends as the `X-Vindera-Key` header to trigger scans.
# Generate with: openssl rand -hex 32
AUTOMATION_SHARED_SECRET="generate_with_openssl_rand_hex_32"

# Bearer token Prometheus uses to scrape /metrics. Generate with: openssl rand -hex 32
# The same value goes into infrastructure/monitoring/secrets/metrics_token.
# Left empty in development, /metrics is open (never in production).
METRICS_TOKEN="generate_with_openssl_rand_hex_32"

# Optional error tracking (leave empty to disable).
SENTRY_DSN=""

# Development aid only: when true, a Keepa/OpenAI failure produces clearly
# marked [MOCK] data instead of a failed scan. Must be false in production.
ALLOW_MOCK_DATA="false"

# Amazon.de return window in days (used to compute the "return by" date).
RETURN_WINDOW_DAYS="30"

# 6. MONITORING (infrastructure/monitoring/docker-compose.yml)
GRAFANA_ADMIN_PASSWORD="choose_a_strong_password"

# ==========================================
# FRONTEND (frontend/.env.local)
# ==========================================
# NEXT_PUBLIC_SUPABASE_URL="your_supabase_project_url_here"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# NEXT_PUBLIC_API_URL="http://localhost:8000"
